{
  "name": "@validation-rules-engine/react",
  "version": "1.0.0",
  "description": "React hooks, provider, and accessible components for Validation Rules Engine (VRE)",
  "keywords": [
    "react",
    "validation",
    "forms",
    "hooks",
    "validation-rules-engine",
    "vre",
    "policy-validation"
  ],
  "license": "MIT",
  "author": "Kalyan K <validationrulesengine@gmail.com>",
  "homepage": "https://kalyan-k.github.io/validation-rules-engine/docs/react-overview",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalyan-k/validation-rules-engine.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/kalyan-k/validation-rules-engine/issues",
    "email": "validationrulesengine@gmail.com"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "import": "./index.js", "default": "./index.js" },
    "./package.json": "./package.json"
  },
  "files": ["*.js", "*.js.map", "**/*.d.ts", "**/*.d.ts.map", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "peerDependencies": {
    "@validation-rules-engine/core": "^1.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": { "@validation-rules-engine/core": "1.0.0" },
  "publishConfig": { "access": "public" }
}
