{
  "routes": [
    {
      "route": "/api/status",
      "rewrite": "/api/status.json"
    },
    {
      "route": "/api/meta",
      "rewrite": "/api/meta.json"
    },
    {
      "route": "/api/playwright/latest",
      "rewrite": "/api/playwright/latest.json"
    },
    {
      "route": "/api/security/latest",
      "rewrite": "/api/security/latest.json"
    },
    {
      "route": "/health",
      "rewrite": "/api/health.json"
    },
    {
      "route": "/health/ready",
      "rewrite": "/api/health-ready.json"
    },
    {
      "route": "/docs/health",
      "rewrite": "/api/docs-health.json"
    },
    {
      "route": "/showcases/angular/health",
      "rewrite": "/api/angular-health.json"
    },
    {
      "route": "/showcases/react/health",
      "rewrite": "/api/react-health.json"
    },
    {
      "route": "/showcases/vanilla/health",
      "rewrite": "/api/vanilla-health.json"
    },
    {
      "route": "/docs",
      "redirect": "/docs/overview/",
      "statusCode": 302
    },
    {
      "route": "/showcases/angular",
      "redirect": "/showcases/angular/showcases/bootstrap",
      "statusCode": 302
    },
    {
      "route": "/showcases/angular/state/*",
      "rewrite": "/showcases/angular/index.html"
    },
    {
      "route": "/showcases/angular/showcases/*",
      "rewrite": "/showcases/angular/index.html"
    },
    {
      "route": "/showcases/angular/reactive-forms",
      "rewrite": "/showcases/angular/index.html"
    },
    {
      "route": "/showcases/angular/sample-form",
      "rewrite": "/showcases/angular/index.html"
    },
    {
      "route": "/showcases/angular/complex-form",
      "rewrite": "/showcases/angular/index.html"
    },
    {
      "route": "/showcases/angular/performance-form",
      "rewrite": "/showcases/angular/index.html"
    },
    {
      "route": "/showcases/react/state/*",
      "rewrite": "/showcases/react/index.html"
    },
    {
      "route": "/showcases/vanilla/simple",
      "rewrite": "/showcases/vanilla/index.html"
    },
    {
      "route": "/showcases/vanilla/complex",
      "rewrite": "/showcases/vanilla/index.html"
    },
    {
      "route": "/showcases/vanilla/performance",
      "rewrite": "/showcases/vanilla/index.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/docs/*",
      "/medium/*",
      "/showcases/*",
      "/reports/*",
      "/automation/*",
      "/security/*",
      "/api/*",
      "/*.{css,js,mjs,map,json,png,jpg,jpeg,gif,ico,svg,webp,woff,woff2,txt,xml,webmanifest}"
    ]
  },
  "mimeTypes": {
    ".json": "application/json",
    ".css": "text/css",
    ".js": "text/javascript",
    ".mjs": "text/javascript",
    ".webmanifest": "application/manifest+json"
  }
}
