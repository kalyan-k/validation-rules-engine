/.angular/cache
/packages/angular/.angular/cache
.sass-cache/
/connect.lock
/coverage
/reports
/docs/private
/artifacts/playwright/html-report/
/artifacts/playwright/json/
/artifacts/playwright/junit/
/artifacts/playwright/catalog/
/artifacts/playwright/screenshots/
/artifacts/playwright/videos/
/artifacts/playwright/traces/
