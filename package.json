{
  "name": "validation-rules-engine-workspace",
  "version": "1.0.0",
  "type": "module",
  "description": "Private monorepo for the Validation Rules Engine, framework adapters, portal, documentation, and showcase applications.",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "ng": "cd packages/angular && ng",
    "start": "npm run start:single-host",
    "host": "npm run start:single-host",
    "start:single-host": "npm run build:site && npm run serve:single-host",
    "serve:single-host": "node dist/apps/portal/server.js --single-host",
    "serve:host": "npm run serve:single-host",
    "start:multi-host": "npm run build:all && npm run serve:multi-host",
    "serve:multi-host": "node tools/hosting/start-multi-host.mjs",
    "portal": "npm run start:multi-host",
    "portal:dev": "npm run build:packages && npm run build:platform && node dist/apps/portal/server.js",
    "serve": "npm run serve:angular-showcase",
    "serve:portal": "node dist/apps/portal/server.js",
    "serve:docs": "npm run build:docs && npm run serve:docs:portal",
    "serve:docs:portal": "node dist/apps/docs/server.js",
    "serve:angular-showcase": "npm run ng -- serve angular-showcase",
    "serve:angular-showcase:portal": "npm run serve:angular-showcase",
    "serve:react-showcase": "vite --config apps/react-showcase/vite.config.ts",
    "serve:react-showcase:portal": "npm run serve:react-showcase",
    "serve:static": "node playwright/scripts/static-server.mjs",
    "start:react-showcase": "npm run serve:react-showcase",
    "build": "npm run build:packages",
    "build:all": "npm run build:platform && npm run build:showcases",
    "build:platform": "npm run build:app:portal && npm run build:app:docs",
    "build:packages": "npm run build:package:core && npm run ng -- build angular --configuration production && npm run build --workspace @validation-rules-engine/react",
    "build:showcases": "npm run build:packages && npm run build:showcase:angular && npm run build:showcase:react",
    "build:app:portal": "tsc -p apps/portal/tsconfig.json",
    "build:app:docs": "tsc -p apps/docs/tsconfig.json",
    "build:package:core": "npm run ng -- build core --configuration production",
    "build:package:angular": "npm run build:package:core && npm run ng -- build angular --configuration production",
    "build:package:react": "npm run build:package:core && npm run build --workspace @validation-rules-engine/react",
    "build:showcase:angular": "npm run ng -- build angular-showcase --configuration production",
    "build:showcase:angular:hosted": "npm run ng -- build angular-showcase --configuration hosted",
    "build:showcase:react": "npm run build --workspace @validation-rules-engine/react-showcase",
    "build:showcase:react:hosted": "vite build --config apps/react-showcase/vite.config.ts --mode single-host",
    "build:site": "npm run build:packages && npm run build:platform && npm run build:showcase:angular:hosted && npm run build:showcase:react:hosted && node tools/hosting/build-site.mjs",
    "site:verify": "node tools/hosting/verify-site.mjs",
    "build:core": "npm run build:package:core",
    "build:angular": "npm run build:package:angular",
    "build:react": "npm run build:package:react",
    "build:lib": "npm run build:package:angular",
    "build:portal": "npm run build:app:portal",
    "build:docs": "npm run build:app:docs",
    "build:angular-showcase": "npm run build:packages && npm run build:showcase:angular",
    "build:react-showcase": "npm run build:package:react && npm run build:showcase:react",
    "build-core": "npm run build:core",
    "watch": "npm run watch:lib",
    "watch:lib": "npm run build:package:core && npm run ng -- build angular --configuration development --watch",
    "pack:lib": "npm run build:lib && npm pack ./dist/packages/angular --dry-run",
    "publish:lib": "npm run build:lib && npm publish ./dist/packages/angular --access public",
    "version:check": "node tools/release/verify-versions.mjs",
    "version:check:dist": "node tools/release/verify-versions.mjs --dist",
    "pack:packages:dry-run": "npm run build:packages && npm run version:check:dist && npm pack ./dist/packages/core --dry-run && npm pack ./dist/packages/angular --dry-run && npm pack ./dist/packages/react --dry-run",
    "release:verify": "npm run version:check && npm audit --audit-level=moderate && npm run lint:all && npm run test:ci && npm run build:site && npm run test:hosting && npm run pack:packages:dry-run",
    "publish:packages": "npm run release:verify && npm publish ./dist/packages/core --access public --provenance && npm publish ./dist/packages/angular --access public --provenance && npm publish ./dist/packages/react --access public --provenance",
    "architecture:verify": "node tools/architecture/verify-dependencies.mjs",
    "branding:verify": "node tools/architecture/verify-branding.mjs",
    "test": "npm run test:platform && npm run test:core && npm run test:angular && npm run test:react && npm run test:showcase:angular && npm run test:showcase:react",
    "test:platform": "npm run build:platform && node --test dist/apps/portal/process-manager.spec.js dist/apps/portal/server.spec.js dist/apps/docs/markdown.spec.js dist/apps/docs/search.spec.js dist/apps/docs/server.spec.js",
    "test:core": "npm run ng -- test core --watch=false --browsers=ChromeHeadlessLocal",
    "test:angular": "npm run ng -- test angular --watch=false --browsers=ChromeHeadlessLocal",
    "test:react": "vitest run --config packages/react/vitest.config.ts && node tools/testing/normalize-vitest-report.mjs react",
    "test:showcase:angular": "npm run ng -- test angular-showcase --watch=false --browsers=ChromeHeadlessLocal",
    "test:showcase:react": "vitest run --config apps/react-showcase/vite.config.ts && node tools/testing/normalize-vitest-report.mjs react-showcase",
    "test:coverage": "npm run test:platform && npm run test:coverage:core && npm run test:coverage:angular && npm run test:coverage:react && npm run test:coverage:showcase:angular && npm run test:coverage:showcase:react",
    "test:coverage:core": "npm run ng -- test core --watch=false --browsers=ChromeHeadlessLocal --code-coverage",
    "test:coverage:angular": "npm run ng -- test angular --watch=false --browsers=ChromeHeadlessLocal --code-coverage",
    "test:coverage:react": "vitest run --config packages/react/vitest.config.ts --coverage && node tools/testing/normalize-vitest-report.mjs react",
    "test:coverage:showcase:angular": "npm run ng -- test angular-showcase --watch=false --browsers=ChromeHeadlessLocal --code-coverage",
    "test:coverage:showcase:react": "vitest run --config apps/react-showcase/vite.config.ts --coverage && node tools/testing/normalize-vitest-report.mjs react-showcase",
    "test:coverage:core:ci": "npm run ng -- test core --watch=false --browsers=ChromeHeadlessCI --code-coverage",
    "test:coverage:angular:ci": "npm run ng -- test angular --watch=false --browsers=ChromeHeadlessCI --code-coverage",
    "test:coverage:react:ci": "npm run test:coverage:react",
    "test:coverage:showcase:angular:ci": "npm run ng -- test angular-showcase --watch=false --browsers=ChromeHeadlessCI --code-coverage",
    "test:coverage:showcase:react:ci": "npm run test:coverage:showcase:react",
    "test:reports": "node tools/testing/run-all-reports.mjs",
    "test:reports:core": "node tools/testing/run-project-report.mjs core",
    "test:reports:angular": "node tools/testing/run-project-report.mjs angular",
    "test:reports:react": "node tools/testing/run-project-report.mjs react",
    "test:reports:showcase:angular": "node tools/testing/run-project-report.mjs angular-showcase",
    "test:reports:showcase:react": "node tools/testing/run-project-report.mjs react-showcase",
    "test:ci": "npm run test:platform && node tools/testing/run-all-reports.mjs --ci",
    "test:all": "npm test",
    "test:watch:core": "npm run ng -- test core",
    "test:watch:angular": "npm run ng -- test angular",
    "test:watch:react": "vitest --config packages/react/vitest.config.ts",
    "test:watch:showcase:angular": "npm run ng -- test angular-showcase",
    "test:watch:showcase:react": "vitest --config apps/react-showcase/vite.config.ts",
    "test:e2e": "node playwright/scripts/run-playwright.mjs",
    "test:e2e:all": "node playwright/scripts/run-playwright.mjs -- --project=chromium --project=firefox --project=webkit",
    "test:e2e:full": "node playwright/scripts/run-playwright.mjs -- --project=chromium --project=firefox --project=webkit --project=accessibility-chromium --project=visual-chromium --project=responsive-tablet --project=responsive-mobile --workers=1 --retries=1",
    "test:e2e:smoke": "node playwright/scripts/run-playwright.mjs -- --project=chromium --grep @smoke",
    "test:e2e:angular": "node playwright/scripts/run-playwright.mjs -- --project=chromium --grep @angular",
    "test:e2e:react": "node playwright/scripts/run-playwright.mjs -- --project=chromium --grep \"(^|\\s)@react(\\s|$)\"",
    "test:e2e:docs": "node playwright/scripts/run-playwright.mjs -- --project=chromium --grep @docs",
    "test:e2e:portal": "node playwright/scripts/run-playwright.mjs -- --project=chromium --grep @portal",
    "test:e2e:reports": "node playwright/scripts/run-playwright.mjs -- --project=chromium --grep @reports",
    "test:e2e:chromium": "node playwright/scripts/run-playwright.mjs -- --project=chromium",
    "test:e2e:firefox": "node playwright/scripts/run-playwright.mjs -- --project=firefox",
    "test:e2e:webkit": "node playwright/scripts/run-playwright.mjs -- --project=webkit",
    "test:e2e:headed": "node playwright/scripts/run-playwright.mjs -- --project=chromium --headed",
    "test:e2e:debug": "node playwright/scripts/run-playwright.mjs -- --project=chromium --debug",
    "test:e2e:ui": "node playwright/scripts/run-playwright.mjs -- --ui",
    "test:e2e:visual": "node playwright/scripts/run-playwright.mjs -- --project=visual-chromium",
    "test:e2e:visual:update": "node playwright/scripts/run-playwright.mjs -- --project=visual-chromium --update-snapshots",
    "test:e2e:accessibility": "node playwright/scripts/run-playwright.mjs -- --project=accessibility-chromium",
    "test:e2e:report": "playwright show-report artifacts/playwright/html-report",
    "test:e2e:catalog": "node playwright/scripts/generate-test-catalog.mjs",
    "test:e2e:clean": "node playwright/scripts/clean-artifacts.mjs",
    "test:e2e:portal-data": "node playwright/scripts/generate-portal-data.mjs",
    "test:e2e:responsive": "node playwright/scripts/run-playwright.mjs -- --project=responsive-tablet --project=responsive-mobile",
    "test:hosting": "npm run test:hosting:multi && npm run test:hosting:single",
    "test:hosting:multi": "node playwright/scripts/run-hosting-navigation.mjs multi",
    "test:hosting:single": "node playwright/scripts/run-hosting-navigation.mjs single",
    "reports:clean": "node tools/testing/clean-reports.mjs",
    "reports:index": "node tools/testing/generate-report-platform.mjs",
    "reports:verify": "node tools/testing/verify-reports.mjs",
    "reports:open": "node tools/testing/open-reports.mjs",
    "lint": "npm run ng -- lint angular",
    "lint:all": "npm run ng -- lint"
  },
  "license": "MIT",
  "dependencies": {
    "@angular/animations": "20.3.25",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.25",
    "@angular/compiler": "20.3.25",
    "@angular/core": "20.3.25",
    "@angular/forms": "20.3.25",
    "@angular/material": "20.2.14",
    "@angular/platform-browser": "20.3.25",
    "@angular/platform-browser-dynamic": "20.3.25",
    "@angular/router": "20.3.25",
    "@datorama/akita": "8.0.1",
    "@ngneat/elf": "^2.5.1",
    "@ngneat/elf-entities": "^5.0.2",
    "@ngrx/store": "^20.1.0",
    "@ngxs/store": "^20.1.0",
    "@rx-angular/cdk": "^20.1.0",
    "@rx-angular/state": "^20.1.0",
    "bootstrap": "^5.3.3",
    "rxjs": "~7.8.0",
    "tslib": "2.4.1",
    "underscore": "^1.13.8",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.25",
    "@angular-eslint/builder": "20.7.0",
    "@angular-eslint/eslint-plugin": "20.7.0",
    "@angular-eslint/eslint-plugin-template": "20.7.0",
    "@angular-eslint/schematics": "20.7.0",
    "@angular-eslint/template-parser": "20.7.0",
    "@angular/cli": "20.3.25",
    "@angular/compiler-cli": "20.3.25",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "26.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/underscore": "^1.13.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^8.57.0",
    "jasmine-core": "~5.4.0",
    "jsdom": "^26.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "mobx": "6.16.1",
    "ng-packagr": "^20.3.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "~5.8.3",
    "vite": "^6.4.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "lodash": "4.18.1",
    "glob": "^13.0.0",
    "ws": "^8.18.0",
    "rollup": "^4.34.0",
    "flatted": "^3.3.2",
    "body-parser": "1.20.6",
    "brace-expansion@<1.1.17": "1.1.18",
    "brace-expansion@>=4.0.0 <5.0.8": "5.0.9",
    "node-forge": "^1.3.2",
    "immutable": "^4.3.8",
    "braces": "^3.0.3",
    "tar": "7.5.22",
    "webpack-dev-middleware": "^7.4.2",
    "minimatch": "^10.2.5",
    "serialize-javascript": "^7.0.5",
    "tmp": "^0.2.4",
    "piscina": "^4.9.0",
    "fast-uri": "3.1.5",
    "uuid": "^11.1.1",
    "mobx": "6.16.1",
    "vite": "$vite",
    "esbuild": "^0.25.0",
    "http-proxy-middleware": "^3.0.7",
    "postcss": "8.5.25",
    "webpack-dev-server": "5.2.6",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@hono/node-server": "2.0.12",
    "@babel/core": "^7.29.1",
    "@sigstore/core": "^3.2.1",
    "karma": {
      "minimatch": "3.1.4"
    }
  }
}
